{
  "name": "VoteToRuinIt-RuptureValley",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "VTR": { "$path": "src/shared" }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "VTRServer": { "$path": "src/server" }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "VTRClient": { "$path": "src/client" }
      }
    },
    "Workspace": {
      "$className": "Workspace",
      "$properties": { "StreamingEnabled": true }
    },
    "Lighting": {
      "$className": "Lighting",
      "$properties": { "GlobalShadows": true }
    }
  }
}
